<?xml version="1.0" encoding="utf-8"?>
<Mod id="b7e4c1d2-3f5a-4a8e-9c6d-2e1f0a9b8c7d" version="7">
	<Properties>
		<Name>Auto Hotseat Loader</Name>
		<Teaser>Automatically loads a hotseat save on startup</Teaser>
		<Description>When the Debug/PlayNowSave entry in AppOptions.txt points at a save file, the front end immediately loads it as a hotseat game and auto-presses Start in the staging room. In that auto-loaded session only, the in-game Save/Start Turn prompt is dismissed automatically whenever Start Turn is enabled. When PlayNowSave is not set the mod does nothing at all. UI only; does not affect saved games.</Description>
		<Authors>jubecker</Authors>
		<CompatibleVersions>2.0</CompatibleVersions>
		<AffectsSavedGames>0</AffectsSavedGames>
	</Properties>
	<FrontEndActions>
		<!-- FrontEndActions do not support ReplaceUIScript, so we override the
		     stock (empty) UI/Test.lua debug context that FrontEnd.xml loads,
		     plus the copyright/logo IntroScreen to shorten its wait. -->
		<ImportFiles id="AutoHotseat_FrontEndFiles">
			<File>UI/Test.lua</File>
			<File>UI/AutoHotseat_FrontEnd.lua</File>
			<File>UI/IntroScreen.lua</File>
		</ImportFiles>
	</FrontEndActions>
	<InGameActions>
		<ReplaceUIScript id="AutoHotseat_PlayerChange">
			<Properties>
				<LuaContext>PlayerChange</LuaContext>
				<LuaReplace>UI/PlayerChange_AutoHotseat.lua</LuaReplace>
			</Properties>
		</ReplaceUIScript>
	</InGameActions>
	<Files>
		<File>UI/Test.lua</File>
		<File>UI/AutoHotseat_FrontEnd.lua</File>
		<File>UI/IntroScreen.lua</File>
		<File>UI/PlayerChange_AutoHotseat.lua</File>
	</Files>
</Mod>
